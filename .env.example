# Copy this file to ".env" and fill in your keys. The .env file is gitignored.
EXPO_PUBLIC_GOOGLE_MAPS_KEY=your_google_maps_key_here
EXPO_PUBLIC_ORS_KEY=your_openrouteservice_key_here
# Discord webhook for in-app beta feedback (also set this in EAS env for OTA builds)
EXPO_PUBLIC_FEEDBACK_WEBHOOK=https://discord.com/api/webhooks/xxx/yyy
